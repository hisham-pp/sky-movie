# Sky Movie Desktop App Environment Variables
# Copy this file to desktop-app/.env or envs/.env.desktop

# TMDB API Key (v3 auth) for fetching movie/series metadata, posters, backdrops, and cast
# Get your API key at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Enable verbose debug logging in main process and player services (optional: 1 or true)
# DEBUG=1

# Enable debug logging for libmpv video player native addon (optional: 1 or true)
# DEBUG_LIBMPV=1

# Electron Renderer URL (set automatically by electron-vite in development)
# ELECTRON_RENDERER_URL=http://localhost:5173
