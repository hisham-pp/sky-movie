{
  "name": "@sky-movie/desktop-app",
  "version": "0.11.2",
  "description": "Local-first desktop movie and TV library manager.",
  "homepage": "https://github.com/hisham-pp/sky-movie",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev -p 3000",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "start:web": "next start",
    "typecheck": "tsc --noEmit",
    "desktop": "electron electron/main.cjs",
    "package:prepare": "node scripts/prepare-standalone.mjs",
    "package:dir": "pnpm build && pnpm package:prepare && electron-builder --win --dir",
    "package:win": "pnpm build && pnpm package:prepare && electron-builder --win",
    "package:win:dir": "pnpm package:dir",
    "package:win:installer": "pnpm package:win",
    "package:current": "pnpm package:win",
    "package:all": "pnpm package:win",
    "package:mac": "pnpm build && pnpm package:prepare && electron-builder --mac",
    "package:linux": "pnpm build && pnpm package:prepare && electron-builder --linux",
    "package": "pnpm package:win"
  },
  "author": "Sky Movie",
  "desktopName": "sky-movie",
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "artplayer": "^5.4.0",
    "better-sqlite3": "^12.2.0",
    "bindings": "^1.5.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "file-uri-to-path": "^2.0.0",
    "lucide-react": "^0.468.0",
    "next": "15.3.0",
    "node-addon-api": "^8.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.0",
    "react-select": "^5.10.2",
    "tailwind-merge": "^2.6.0",
    "webtorrent": "^3.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
