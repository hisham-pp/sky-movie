# Sky Movie Desktop App Environment Configuration
# Copy this file to desktop-app/.env or set these in your shell/CI environment.

# The Movie Database (TMDB) API Key (v3 or v4 Read Access Token)
# Used for fetching movie/show metadata, high-resolution backdrops, posters, cast, and relations.
# Get a free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Verbose debug logging in main process and player services (optional: 1 or true)
# DEBUG=1

# Native libmpv player debug output (optional: 1 or true)
# DEBUG_LIBMPV=1
