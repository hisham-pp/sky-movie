# Code Signing & Notarization Configuration
# Copy this file to envs/.env.codesign or export as environment variables.
# See docs/CODE_SIGNING.md for complete instructions.

# -----------------------------------------------------------------------------
# Windows Code Signing
# -----------------------------------------------------------------------------
# Password for the Windows .pfx certificate file
WINDOWS_CERT_PASSWORD=your_certificate_password_here

# Or SHA1 thumbprint if using certificate installed in Windows Certificate Store
# WINDOWS_CERT_SHA1=your_cert_sha1_thumbprint_here

# electron-builder certificate configuration (alternative)
# CSC_LINK=C:\path\to\cert.pfx
# CSC_KEY_PASSWORD=your_certificate_password_here

# -----------------------------------------------------------------------------
# macOS Code Signing & Notarization
# -----------------------------------------------------------------------------
# Apple ID associated with your Apple Developer account
APPLE_ID=your_apple_id_email@example.com

# App-specific password generated at https://appleid.apple.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 10-character Apple Developer Team ID
APPLE_TEAM_ID=XXXXXXXXXX

# electron-builder macOS certificate (base64 or file path)
# CSC_LINK=/path/to/developer_id_application.p12
# CSC_KEY_PASSWORD=your_certificate_password_here
