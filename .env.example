# =============================================================================
# Sky Movie - Master Environment Variables Example (.env.example)
# =============================================================================
# This file lists all environment variables across all services and scripts.
# For modular per-service configs, refer to the envs.example/ directory:
#   - envs.example/.env.desktop.example  (Desktop app & TMDB)
#   - envs.example/.env.r2.example       (Cloudflare R2 releases)
#   - envs.example/.env.github.example   (GitHub Releases)
#   - envs.example/.env.gpg.example      (Linux GPG signing)
#   - envs.example/.env.codesign.example (Windows/macOS code signing)
#   - envs.example/.env.drive.example    (Google Drive releases - deprecated)
#
# IMPORTANT: Never commit actual secret values into git.
# =============================================================================

# =============================================================================
# 1. Desktop Application & TMDB (desktop-app/.env or envs/.env.desktop)
# =============================================================================
# TMDB API Key (v3 auth) for fetching movie/series metadata, posters, backdrops, and cast
# Get your API key at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Enable verbose debug logging in main process and player services (optional: 1 or true)
# DEBUG=1

# Enable debug logging for libmpv video player native addon (optional: 1 or true)
# DEBUG_LIBMPV=1


# =============================================================================
# 2. Cloudflare R2 Distribution (envs/.env.r2)
# =============================================================================
# Cloudflare account ID from the Workers & Pages / R2 dashboard URL
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# R2 bucket storing release binaries and installer artifacts
CLOUDFLARE_R2_BUCKET=sky-movie-releases

# R2 API token with Object Read & Write permissions
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Public bucket URL or custom domain used for download links (e.g. https://downloads.example.com)
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://downloads.example.com

# Optional prefix inside bucket (releases are placed under <prefix>/v<version>/)
CLOUDFLARE_R2_PREFIX=releases


# =============================================================================
# 3. GitHub Releases Configuration (envs/.env.github)
# =============================================================================
# GitHub Personal Access Token (PAT) with repo scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Optional: Override repository owner and name (detected from git remote by default)
# GITHUB_OWNER=your-github-username
# GITHUB_REPO=sky-movie


# =============================================================================
# 4. Linux Package Signing (GPG) (envs/.env.gpg)
# =============================================================================
# GPG Private Key (ASCII-armored format)
# Generate with: gpg --armor --export-secret-keys your@email.com
# GPG_PRIVATE_KEY=-----BEGIN PGP PRIVATE KEY BLOCK-----\n...\n-----END PGP PRIVATE KEY BLOCK-----

# GPG Passphrase (the password set when creating the key)
# GPG_PASSPHRASE=your-passphrase-here

# Optional: GPG Key ID (gpg --list-secret-keys --keyid-format LONG)
# GPG_KEY_ID=YOUR_KEY_ID_HERE


# =============================================================================
# 5. Windows & macOS Code Signing & Notarization (envs/.env.codesign)
# =============================================================================
# Windows .pfx certificate password
# WINDOWS_CERT_PASSWORD=your_certificate_password_here

# Or certificate thumbprint from Windows Certificate Store
# WINDOWS_CERT_SHA1=your_cert_sha1_thumbprint_here

# macOS Apple Developer credentials for Gatekeeper Notarization
# APPLE_ID=your_apple_id_email@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX

# electron-builder certificate configuration (alternative)
# CSC_LINK=/path/to/cert.p12_or_pfx
# CSC_KEY_PASSWORD=your_certificate_password_here


# =============================================================================
# 6. Google Drive Releases (Deprecated) (envs/.env.drive)
# =============================================================================
# Parent Google Drive folder ID
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Path to Google service account JSON file
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\sky-movie-drive-service-account.json
